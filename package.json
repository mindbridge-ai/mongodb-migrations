{
  "name": "mongodb-migrations",
  "version": "0.8.5",
  "description": "A migration framework for MongoDB",
  "main": "lib/mongodb-migrations.js",
  "scripts": {
    "build": "npm run build:ts && npm run build:coffee",
    "build:coffee": "coffee --compile --output lib src",
    "build:ts": "tsc",
    "prepublish": "npm run build",
    "test": "mocha -r ts-node/register --compilers coffee:coffeescript/register -r should --timeout 2000 \"test/**/*.{coffee,ts}\"",
    "dev": "concurrently \"tsc --watch\" \"coffee --watch --compile --output lib src\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/emirotin/mongodb-migrations.git"
  },
  "keywords": [
    "mongodb",
    "mongo",
    "migrate",
    "migration",
    "migrations"
  ],
  "author": "Eugene Mirotin <emirotin@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emirotin/mongodb-migrations/issues"
  },
  "homepage": "https://github.com/emirotin/mongodb-migrations",
  "dependencies": {
    "bluebird": "^3.4.1",
    "lodash": "^4.13.0",
    "mkdirp": "^3.0.1",
    "mongodb": "^6.3.0",
    "mongodb-legacy": "^6.1.3"
  },
  "devDependencies": {
    "@types/bluebird": "^3.5.42",
    "@types/lodash": "^4.17.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.19",
    "coffeescript": "^2.5.1",
    "concurrently": "^9.1.2",
    "mocha": "^3.2.0",
    "rimraf": "^5.0.5",
    "should": "^13.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
